# FasalNama environment (copy to .env; never commit .env)
RUN_MODE=local                       # local | cloud

# Database: SQLite locally, Postgres on Render
DATABASE_URL=sqlite:///./fasalnama.db

# Backend selection
STT_BACKEND=local                    # local | groq
LLM_BACKEND=ollama                   # ollama | groq
VISION_BACKEND=local                 # local | groq
TTS_BACKEND=piper                    # piper | elevenlabs | none

# Local model names
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5
OLLAMA_VISION_MODEL=llava

# Cloud (optional, open-weight hosted on Groq)
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_LLM_MODEL=
GROQ_VISION_MODEL=

# Optional proprietary TTS
ELEVENLABS_API_KEY=

# Security / web
APP_PASSCODE=
CORS_ORIGINS=http://localhost:5173

# Photo storage
PHOTO_STORE=db                       # db | s3