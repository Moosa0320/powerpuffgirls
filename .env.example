# FasalNama environment (copy to .env; never commit .env)
# Keys and IDs stay blank here. A blank key or model ID turns that backend off.
RUN_MODE=local                       # local | cloud

# Database: SQLite locally, hosted Postgres (Neon) in the cloud
DATABASE_URL=sqlite:///./fasalnama.db

# Backend selection. Chain: configured backend -> local backend (if available)
# -> typed input (STT) / no audio (TTS).
STT_BACKEND=local                    # local | groq
LLM_BACKEND=ollama                   # ollama | groq
VISION_BACKEND=local                 # local | groq | hf
TTS_BACKEND=piper                    # piper | elevenlabs | none

# Local open-weight models (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5
OLLAMA_VISION_MODEL=llava
WHISPER_MODEL_SIZE=small             # faster-whisper size: tiny | base | small | medium | large-v3
PIPER_BIN=piper                      # Piper CLI on PATH, or a full path to the binary
PIPER_VOICE=                         # path to a Piper .onnx voice; Piper TTS is off until set

# Groq (optional, hosted open-weight models). Copy model IDs from the Groq console.
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_LLM_MODEL=
GROQ_VISION_MODEL=

# Hugging Face router (optional hosted vision, VISION_BACKEND=hf). Needs HF_TOKEN.
# Model format is repo:provider; the suffix picks the HF inference provider.
HF_TOKEN=
HF_VISION_MODEL=Qwen/Qwen3-VL-2B-Instruct:featherless-ai

# ElevenLabs (optional proprietary TTS, cloud report playback). Needs the key and a voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Security / web
APP_PASSCODE=
CORS_ORIGINS=http://localhost:5173

# Photo storage
PHOTO_STORE=db                       # db | s3
